{
  "name": "nurigeul",
  "productName": "누리글",
  "version": "1.5.72",
  "description": "아래아한글 단축키를 따르는 가벼운 문서 편집기 (HWPX)",
  "main": "main.js",
  "author": {
    "name": "mihoon",
    "email": "topcfp@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/icons.js",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "docx": "^9.7.2",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1",
    "lucide-static": "*"
  },
  "build": {
    "appId": "kr.nurigeul.editor",
    "productName": "누리글",
    "copyright": "누리글",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "hwpx",
        "name": "HWPX 문서",
        "description": "한글 문서 (HWPX)",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nurigeul-${version}-win-${arch}.${ext}",
      "executableName": "Nurigeul"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "누리글",
      "artifactName": "Nurigeul-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Nurigeul-Portable-${version}.exe"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "executableName": "nurigeul",
      "artifactName": "Nurigeul-${version}-linux-${arch}.${ext}",
      "synopsis": "아래아한글 대신 쓰는 가벼운 문서 편집기",
      "description": "HWPX/HWP 문서를 열고 편집·저장하는 한글 문서 편집기",
      "mimeTypes": [
        "application/hwp+zip",
        "application/x-hwp",
        "application/haansofthwpx",
        "text/markdown"
      ],
      "desktop": {
        "entry": {
          "Name": "누리글",
          "Comment": "한글(HWPX) 문서 편집기"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "fonts-noto-cjk",
        "fonts-nanum"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mihoon/nurigeul.git"
  },
  "homepage": "https://github.com/mihoon/nurigeul",
  "desktopName": "nurigeul.desktop"
}
